{
  "name": "@exgael/swiftyreact",
  "author": "exgael",
  "description": "SwiftUI style components for ReactJS",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exgael/SwiftyReact.git"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "Swift",
    "React",
    "VStack",
    "Hstack",
    "ZStack",
    "SwiftUI",
    "ReactJS"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "types": ".dist/index.d.ts",
  "main": ".dist/swiftyreact.umd.cjs",
  "module": ".dist/swiftyreact.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/swiftyreact.js",
      "require": "./dist/swiftyreact.umd.cjs"
    }
  },
  "scripts": {
    "init": "make install",
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "build2": "rm -rf dist && tsc -b && vite build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
